fn quantize_srgb8(value: f32) -> u32 {
    if !(value > 0.0) {
        return 0u;
    }
    if value >= 1.0 {
        return 255u;
    }

    let bits = bitcast<u32>(value);
    var low = 0u;
    var high = 255u;
    for (var step = 0u; step < 8u; step += 1u) {
        let middle = (low + high) / 2u;
        if bits >= SRGB_THRESHOLDS[middle] {
            low = middle + 1u;
        } else {
            high = middle;
        }
    }
    return low;
}

fn quantize_alpha8(value: f32) -> u32 {
    if !(value > 0.0) {
        return 0u;
    }
    if value >= 1.0 {
        return 255u;
    }
    let bits = bitcast<u32>(value);
    var low = 0u;
    var high = 255u;
    for (var step = 0u; step < 8u; step += 1u) {
        let middle = (low + high) / 2u;
        if bits >= ALPHA_THRESHOLDS[middle] {
            low = middle + 1u;
        } else {
            high = middle;
        }
    }
    return low;
}

@fragment
fn fragment_exact(input: VertexOutput) -> @location(0) vec4<f32> {
    let size = textureDimensions(source);
    let coordinate = min(vec2<u32>(input.position.xy), size - vec2<u32>(1u));
    let color = textureLoad(source, vec2<i32>(coordinate), 0);
    let encoded = vec4<u32>(
        quantize_srgb8(color.r),
        quantize_srgb8(color.g),
        quantize_srgb8(color.b),
        quantize_alpha8(color.a),
    );
    return vec4<f32>(encoded) / 255.0;
}
