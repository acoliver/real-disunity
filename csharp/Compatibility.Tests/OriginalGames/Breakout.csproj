<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ExpectedSourceCount>7</ExpectedSourceCount>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../UnityCompat/UnityCompat.csproj" />
    <OriginalSource Include="../../../.work/games/breakout/Assets/Scripts/**/*.cs" Exclude="**/Tests/**;**/Editor/**" />
    <Compile Include="@(OriginalSource)" />
  </ItemGroup>
  <Target Name="QualifyOriginalSources" BeforeTargets="CoreCompile">
    <Error Condition="'@(OriginalSource->Count())' != '$(ExpectedSourceCount)'" Text="Breakout: expected $(ExpectedSourceCount) original sources, found @(OriginalSource->Count()). Empty or changed source census is forbidden." />
    <WriteLinesToFile File="$(IntermediateOutputPath)original-sources.txt" Lines="@(OriginalSource->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
