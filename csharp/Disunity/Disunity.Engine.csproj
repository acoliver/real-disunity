<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads and rewrites a player's game assemblies at load (see PlayerCallbackRewriter). MIT licensed. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ABI surface the native build generates; NativeAbi hashes it into the revision the native library reports. -->
    <EmbeddedResource Include="../../crates/disunity-ffi/abi/surface.g.txt" LogicalName="Disunity.AbiSurface" Link="abi/surface.g.txt" />
  </ItemGroup>

</Project>
