<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ExpectedSourceCount>20</ExpectedSourceCount>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../UnityCompat/UnityCompat.csproj" />
    <OriginalSource Include="$(OriginalGamesRoot)/Assets/Scripts/**/*.cs" Exclude="**/Tests/**;**/Editor/**" />
    <Compile Include="@(OriginalSource)" />
  </ItemGroup>
  <Target Name="ValidateOriginalSources" BeforeTargets="CoreCompile">
    <Error Condition="'$(OriginalGamesRoot)' == ''" Text="OriginalGamesRoot must select a pinned source checkout." />
    <Error Condition="'@(OriginalSource->Count())' != '$(ExpectedSourceCount)'" Text="Pong: expected $(ExpectedSourceCount) original sources, found @(OriginalSource->Count()). Empty or changed source census is forbidden." />
    <WriteLinesToFile File="$(IntermediateOutputPath)original-sources.txt" Lines="@(Compile->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
